ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance

JWT_SECRET_KEY=change-me-to-a-long-random-value-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI-compatible API, used only for Tier 3 categorization fallback and
# text-to-SQL template selection. Never hardcode this key in source.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

CATEGORIZATION_CONFIDENCE_THRESHOLD=0.75

# Tier 1 statement parsing
UPLOAD_STORAGE_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=15728640
BANK_PROFILE_FUZZY_MATCH_THRESHOLD=90.0
PDF_STRUCTURE_DETECTION_PAGE_SAMPLE=3
OCR_MIN_CONFIDENCE=40.0
