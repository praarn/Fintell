# Copy to .env.prod and fill in. .env.prod is gitignored — never commit it.
# Used by docker-compose.prod.yml (via --env-file .env.prod).

# --- deployment ------------------------------------------------------------
# The public domain. Its A/AAAA record must point at this server, and ports
# 80 + 443 must be open. Caddy gets a TLS cert for it automatically.
DOMAIN=fintell.example.com

# --- database ------------------------------------------------------------
POSTGRES_USER=finance
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=finance

# --- backend -----------------------------------------------------------
ENVIRONMENT=production

# HS256 signing key for access/refresh tokens. Must be long and random.
# Generate: openssl rand -hex 48
JWT_SECRET_KEY=CHANGE_ME_64_plus_hex_chars

# Optional. Enables Tier 3 LLM categorization and the "Ask your finances"
# box. Leave blank to run without them (they degrade gracefully).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
