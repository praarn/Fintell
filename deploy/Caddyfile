# Single domain. Caddy obtains and renews a Let's Encrypt cert for {$DOMAIN}
# automatically (the server must be reachable on ports 80 and 443).
#
#   https://DOMAIN/           -> frontend (Next.js) :3000
#   https://DOMAIN/api/...    -> backend (FastAPI)  :8000   (the /api prefix is stripped)

{$DOMAIN} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
